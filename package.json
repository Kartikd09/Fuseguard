{
  "name": "fuseguard",
  "version": "0.1.0",
  "private": true,
  "description": "The circuit breaker for AI agents — a drop-in enforcing proxy for LLM budgets.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "packages/hosted/dashboard"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc --build",
    "dev:proxy": "npm run dev --workspace @fuseguard/core",
    "dev:dashboard": "npm run dev --workspace @fuseguard/dashboard",
    "build:dashboard": "npm run build --workspace @fuseguard/dashboard",
    "test:dashboard": "npm run test --workspace @fuseguard/dashboard"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.10",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.9"
  }
}
