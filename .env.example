# FuseGuard environment — copy to .env and fill. NEVER commit .env.

# === Proxy (Cloudflare Worker) ===
# Upstream LLM provider base URL (Anthropic first)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key is SERVER-ONLY. Set via wrangler secret / GH secret, not in client.
SUPABASE_SERVICE_ROLE_KEY=server-only-never-expose

# === Encryption ===
# Key used to encrypt customer-stored LLM API keys at rest (32-byte base64).
# Generate: openssl rand -base64 32
FUSEGUARD_ENCRYPTION_KEY=

# === Lemon Squeezy (billing) ===
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# === Dashboard (Next.js, public-safe NEXT_PUBLIC_* only) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
