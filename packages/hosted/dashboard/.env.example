# FuseGuard Dashboard — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.

# Supabase (public — safe to expose; RLS enforces data access)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# These are set ONLY in the CF Pages / Wrangler environment, never in .env.local
# SUPABASE_SERVICE_ROLE_KEY=  # server-side only; never exposed to browser

# Server-only (NEVER NEXT_PUBLIC). 32-byte base64 — encrypts customer Anthropic keys at rest.
# Generate: openssl rand -base64 32
FG_MASTER_KEY=
