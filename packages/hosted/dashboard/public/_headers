# Static asset long-lived cache — OpenNext serves _next/static via the ASSETS binding.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Security headers applied to all application responses.
# next.config.ts headers() is the runtime source; this file covers Workers-served responses
# that bypass Next.js middleware (static assets are excluded above).
# Users paste a live Anthropic secret here — these headers are not optional.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
