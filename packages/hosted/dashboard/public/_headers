# Cloudflare Pages applies these headers to all responses. Mirrors the defense-in-depth
# headers in next.config.ts headers() — next-on-pages does not reliably apply those on CF Pages,
# so this _headers file is the authoritative source for the deployed dashboard.
# Users paste a live Anthropic secret here, so these are not optional.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
